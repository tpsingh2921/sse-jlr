<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f8f2">
    <meta name="description" content="<%= document.description %>">
    <meta name="author" content="Shree Shantinath Enterprises">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= document.pageTitle %>">
    <meta property="og:description" content="<%= document.description %>">
    <title><%= document.pageTitle %></title>
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon-safety.svg?v=7">
    <link rel="shortcut icon" href="/favicons/favicon-safety.svg?v=7">
    <link rel="apple-touch-icon" href="/favicons/favicon-safety.svg?v=7">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=28">
    <script>
      (function() {
        if (localStorage.getItem('sse_theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      })();
    </script>
    <script type="application/ld+json"><%- JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": document.pageTitle,
      "description": document.description,
      "author": { "@type": "Organization", "name": "Shree Shantinath Enterprises" },
      "publisher": { "@type": "Organization", "name": "Shree Shantinath Enterprises" }
    }) %></script>
  </head>
  <body class="safety-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Shree Shantinath Enterprises home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/images/brand-mark.svg" alt="" width="48" height="48">
          </span>
          <span class="brand-name">SHREE SHANTINATH <b>ENTERPRISES</b></span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
          <a href="/#services">What we do</a>
          <a href="/#about">Our approach</a>
          <a href="/#sectors">Who we serve</a>
          <details class="nav-dropdown">
            <summary aria-current="page">Safety &amp; policies</summary>
            <div class="nav-dropdown-menu">
              <% for (const item of Object.values(safetyDocuments)) { %>
                <a href="/<%= item.slug %>"<% if (item.slug === document.slug) { %> aria-current="page"<% } %>><%= item.title %></a>
              <% } %>
            </div>
          </details>
          <a href="/letterhead" class="nav-admin-link">Admin Login</a>
          <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark mode theme" title="Toggle gradient dark theme">
            <span class="sun-icon" style="display:none;">☀️</span>
            <span class="moon-icon">🌙</span>
            <span class="theme-toggle-label">Dark</span>
          </button>
          <a class="nav-cta" href="/#contact">Start a conversation <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="safety-hero">
        <div class="section-shell safety-hero-grid">
          <div class="safety-hero-inner">
            <p class="eyebrow"><span class="eyebrow-line"></span> STATUTORY COMPLIANCE &amp; SAFETY</p>
            <p class="safety-breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Safety &amp; Policies</span></p>
            <h1><%= document.title %><span>.</span></h1>
            <p class="safety-intro"><%= document.intro %></p>
            <div class="safety-hero-actions">
              <a class="button button-dark" href="<%= document.source %>" target="_blank" rel="noopener"><%= document.sourceLabel %><span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#safety-details">Explore safety guidelines <span aria-hidden="true">↓</span></a>
            </div>
            <div class="safety-trust-pill">
              <span class="trust-dot"></span> Certified Zero-Harm Safety Protocol &bull; Rajasthan Clean Energy Sites
            </div>
          </div>

          <div class="safety-hero-art" aria-label="Animated Clean Energy Safety Art" role="img">
            <!-- Sky Ambient Motes -->
            <div class="floating-motes-wrap" aria-hidden="true">
              <span class="mote mote-1"></span>
              <span class="mote mote-2"></span>
              <span class="mote mote-3"></span>
              <span class="mote mote-4"></span>
            </div>

            <!-- Glowing Radiant Clean Energy Sun -->
            <div class="canvas-sun-wrap safety-sun-wrap">
              <div class="sun-halo"></div>
              <div class="sun-core"></div>
              <div class="sun-rays-pulse"></div>
            </div>

            <!-- Contoured Hills Layer Back -->
            <div class="hills-layer hills-back safety-hills-back"></div>

            <!-- Primary Wind Turbine with Tapered Mast, LED Beacon & Rotating Blades -->
            <div class="wind-turbine turbine-primary speed-normal safety-turbine-primary">
              <div class="turbine-tower">
                <span class="turbine-beacon"></span>
              </div>
              <div class="turbine-head">
                <div class="turbine-hub"></div>
                <div class="turbine-blades">
                  <span class="blade blade-1"></span>
                  <span class="blade blade-2"></span>
                  <span class="blade blade-3"></span>
                </div>
              </div>
            </div>

            <!-- Secondary Distant Wind Turbine for True Horizon Field Depth -->
            <div class="wind-turbine turbine-secondary speed-normal safety-turbine-secondary">
              <div class="turbine-tower">
                <span class="turbine-beacon"></span>
              </div>
              <div class="turbine-head">
                <div class="turbine-hub"></div>
                <div class="turbine-blades">
                  <span class="blade blade-1"></span>
                  <span class="blade blade-2"></span>
                  <span class="blade blade-3"></span>
                </div>
              </div>
            </div>

            <!-- Contoured Hills Layer Front -->
            <div class="hills-layer hills-front safety-hills-front"></div>

            <!-- 3D Angled Solar PV Array Tables with Reflective Sheen Sweeps -->
            <div class="solar-pv-farm safety-solar-farm">
              <div class="solar-table table-1">
                <div class="solar-cells-grid">
                  <span class="cell"></span><span class="cell"></span>
                  <span class="cell"></span><span class="cell"></span>
                </div>
                <div class="solar-sheen-sweep"></div>
              </div>
              <div class="solar-table table-2">
                <div class="solar-cells-grid">
                  <span class="cell"></span><span class="cell"></span>
                  <span class="cell"></span><span class="cell"></span>
                </div>
                <div class="solar-sheen-sweep"></div>
              </div>
              <div class="solar-table table-3">
                <div class="solar-cells-grid">
                  <span class="cell"></span><span class="cell"></span>
                  <span class="cell"></span><span class="cell"></span>
                </div>
                <div class="solar-sheen-sweep"></div>
              </div>
            </div>

            <!-- Floating Verified Safety Protocol Badge -->
            <div class="safety-badge-floating">
              <span class="safety-badge-icon">🛡️</span>
              <div>
                <strong>ISO / OSHA Compliant</strong>
                <small>Zero Incidents Mandate</small>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="safety-content section-shell" id="safety-details">
        <aside class="safety-sidebar" aria-label="Safety documents">
          <p>OUR SAFETY FRAMEWORK</p>
          <% for (const item of Object.values(safetyDocuments)) { %>
            <a href="/<%= item.slug %>"<% if (item.slug === document.slug) { %> aria-current="page"<% } %>><%= item.title %><span aria-hidden="true">↗</span></a>
          <% } %>
          <div class="source-note">The original document is available to view or download as a PDF.</div>
        </aside>
        <div class="safety-article">
          <% document.sections.forEach((section, index) => { %>
            <section class="safety-section reveal">
              <span class="safety-section-number"><%= String(index + 1).padStart(2, "0") %></span>
              <div>
                <h2><%= section.heading %></h2>
                <% if (section.intro) { %><p class="safety-section-intro"><%= section.intro %></p><% } %>
                <% if (section.items.length) { %>
                  <div class="safety-items">
                    <% section.items.forEach((item) => { %>
                      <article>
                        <span aria-hidden="true">✳</span>
                        <div><h3><%= item.title %></h3><p><%= item.body %></p></div>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </section>
          <% }) %>
          <div class="safety-source">
            <span class="safety-source-icon" aria-hidden="true">↗</span>
            <div><h2>Read the source document</h2><p>See the original PDF for the complete document and its additional context.</p></div>
            <a class="button button-dark" href="<%= document.source %>" target="_blank" rel="noopener">View PDF <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="safety-contact">
        <div class="section-shell safety-contact-inner">
          <div><p class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> WORK WITH US</p><h2>Safety starts with<br><span>a good conversation.</span></h2></div>
          <a class="button button-light" href="/#contact">Discuss your project <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell footer-main">
        <a class="brand footer-brand" href="/">
          <span class="brand-mark" aria-hidden="true"><img src="/images/brand-mark.svg" alt="" width="48" height="48"></span>
          <span class="brand-name">SHREE SHANTINATH <b>ENTERPRISES</b></span>
        </a>
        <p>Building sustainable energy<br>infrastructure together.</p>
        <a class="footer-top" href="#">Back to top ↑</a>
      </div>
      <div class="section-shell footer-bottom"><span>© <span id="year">2026</span> Shree Shantinath Enterprises</span><span>QUALITY · SAFETY · SUSTAINABILITY</span><span>GSTIN 08BOKPV8974D1Z5</span></div>
    </footer>
    <script src="/js/main.js?v=2" defer></script>
  </body>
</html>
