<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#071a14">
    <meta name="robots" content="noindex, nofollow">
    <title><%= isNew ? 'New Document' : 'Edit Document' %> | Letterhead | Shree Shantinath Enterprises</title>
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon-letterhead.svg?v=7">
    <link rel="shortcut icon" href="/favicons/favicon-letterhead.svg?v=7">
    <link rel="apple-touch-icon" href="/favicons/favicon-letterhead.svg?v=7">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=33">
    <script>
      (function() {
        if (localStorage.getItem('sse_theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
  </head>
  <body class="letterhead-admin admin-hub-body">
    <!-- Top Global Admin Bar -->
    <header class="site-header admin-global-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Shree Shantinath Enterprises home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/images/brand-mark.svg" alt="" width="40" height="40">
          </span>
          <span class="brand-name">SHREE SHANTINATH <b>ENTERPRISES</b></span>
        </a>

        <!-- Admin Navigation Tabs -->
        <nav class="admin-top-tabs">
          <a href="/letterhead" class="admin-tab is-active">
            <span class="tab-icon">📄</span> Letterheads
          </a>
          <a href="/admin/invoices" class="admin-tab ">
            <span class="tab-icon">🧾</span> Tax Invoices
          </a>
          <a href="/admin/enquiries" class="admin-tab ">
            <span class="tab-icon">📬</span> Client Enquiries
          </a>
        </nav>

                <div class="admin-header-actions">
          <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark mode theme" title="Toggle gradient dark theme">
            <span class="sun-icon" style="display:none;">☀️</span>
            <span class="moon-icon">🌙</span>
            <span class="theme-toggle-label">Dark</span>
          </button>
          <% if (locals.adminUser) { %>
            <div class="admin-user-pill desktop-only-user-pill">
              <span class="user-status-dot"></span>
              <span><%= adminUser.name %></span>
            </div>
          <% } %>
          <a class="admin-back-link desktop-only-link" href="/" target="_blank">View Site ↗</a>
          <form action="/letterhead/logout" method="post" class="desktop-only-logout-form" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="admin-link-button" type="submit">Sign out</button>
          </form>

          <!-- Mobile Profile Trigger & Popover Menu -->
          <div class="admin-mobile-profile-wrap">
            <button type="button" class="mobile-profile-trigger" id="mobileProfileTrigger" aria-label="Toggle user menu" aria-expanded="false">
              <span class="profile-avatar-circle">
                <%= (locals.adminUser && adminUser.name) ? adminUser.name.charAt(0).toUpperCase() : 'H' %>
              </span>
              <span class="profile-online-badge"></span>
            </button>

            <div class="mobile-profile-dropdown" id="mobileProfileDropdown" role="menu">
              <div class="dropdown-user-header">
                <div class="dropdown-avatar">
                  <%= (locals.adminUser && adminUser.name) ? adminUser.name.charAt(0).toUpperCase() : 'H' %>
                </div>
                <div class="dropdown-user-meta">
                  <strong class="dropdown-user-name"><%= locals.adminUser ? adminUser.name : 'Harshvardhan Singh' %></strong>
                  <span class="dropdown-user-role">Online • Master Admin</span>
                </div>
              </div>
              <div class="dropdown-divider"></div>
              <a href="/" target="_blank" class="dropdown-menu-item" role="menuitem">
                <span>View Public Site</span> ↗
              </a>
              <div class="dropdown-divider"></div>
              <form action="/letterhead/logout" method="post" class="dropdown-logout-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-menu-item dropdown-logout-btn" role="menuitem">
                  <span>Sign out</span> 🚪
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-main admin-main-wide">
      <div class="admin-page-heading editor-heading">
        <div>
          <p class="eyebrow"><span class="eyebrow-line"></span> EXECUTIVE LETTERHEAD COMPOSER</p>
          <h1><%= isNew ? 'Compose New' : 'Edit' %> <span>Document.</span></h1>
          <p class="admin-description">
            Your draft updates live in the print-ready preview on the right. When finalized, download a crisp vector PDF.
          </p>
        </div>
        <div class="admin-heading-actions">
          <a class="button button-outline" href="/letterhead">Cancel &amp; Return</a>
        </div>
      </div>

      <% if (locals.saved) { %>
        <p class="admin-alert admin-alert-success" role="status">Your letterhead document has been saved successfully.</p>
      <% } %>
      <% if (locals.error) { %>
        <p class="admin-alert admin-alert-error" role="alert"><%= error %></p>
      <% } %>

      <div class="editor-workspace">
        <!-- Editor Form -->
        <form class="letterhead-editor-form modern-editor-panel" action="<%= isNew ? '/letterhead/documents' : '/letterhead/documents/' + document.id %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="editor-meta-grid">
            <label class="editor-title">
              Internal Title *
              <input name="title" maxlength="160" value="<%= document.title %>" placeholder="e.g. Work Completion Certificate - Bhadla Solar Park" required>
            </label>

            <div class="editor-row-2col">
              <label>
                Document Date
                <input name="date" type="date" value="<%= document.document_date ? new Date(document.document_date).toISOString().slice(0, 10) : '' %>">
              </label>
              <label>
                Reference Number
                <input name="reference" maxlength="100" value="<%= document.reference %>" placeholder="e.g. SSE/TPREL/2026-27/042">
              </label>
            </div>

            <label class="editor-recipient-label">
              To / Recipient Details
              <textarea name="recipient" rows="3" maxlength="500" placeholder="The Project Director&#10;Tata Power Renewable Energy Limited&#10;Bikaner Solar Park Site, Rajasthan"><%= document.recipient %></textarea>
            </label>

            <label class="editor-subject">
              Formal Subject Line
              <input name="subject" maxlength="300" value="<%= document.subject %>" placeholder="e.g. Handover of 33kV Inverter Room Plinths and Cable Trenches"><span class="field-hint">Highlighted prominently in a formal gold-accented subject banner.</span>
            </label>
          </div>

          <label class="editor-body-label">
            Letter Content *
            <textarea name="content" rows="18" maxlength="20000" placeholder="Dear Sir/Madam,&#10;&#10;We are pleased to submit the civil foundation hand-over documentation for the 250 MW Solar PV Plant at Bikaner, Rajasthan...&#10;&#10;Use a blank line between paragraphs for clean spacing." required><%= document.content %></textarea>
            <span class="editor-hint">
              <strong>Formatting Tip:</strong> Text is automatically formatted with justified alignment, clean line-height (1.65), and balanced margins. If content exceeds a single page, the downloaded PDF automatically continues onto page two.
            </span>
          </label>

          <div class="editor-footer">
            <a class="admin-cancel-link" href="/letterhead">Discard Changes</a>
            <div class="editor-actions">
              <a class="button button-outline" href="/letterhead/template" target="_blank" rel="noopener">Preview Template ↗</a>
              <% if (!isNew) { %>
                <a class="button button-outline" href="/letterhead/documents/<%= document.id %>/download">Download PDF ↓</a>
              <% } %>
              <button class="button button-dark" type="submit">
                <span><%= isNew ? 'Save Document' : 'Update & Save' %></span>
                <span aria-hidden="true">↗</span>
              </button>
            </div>
          </div>
        </form>

        <!-- Live Print-Ready Preview -->
        <section class="letterhead-preview modern-preview-panel" aria-labelledby="letterhead-preview-title">
          <div class="letterhead-preview-heading">
            <div>
              <p class="eyebrow"><span class="eyebrow-line"></span> LIVE PRINT PREVIEW</p>
              <h2 id="letterhead-preview-title">Official Letterhead</h2>
            </div>
            <span class="preview-page-size">A4 FORMAT · 210 × 297 MM</span>
          </div>

          <p class="live-preview-status" id="live-preview-status" role="status" aria-live="polite">
            Interactive preview mirrors the downloaded PDF document.
          </p>

          <div class="letterhead-preview-frame">
            <article class="letterhead-paper filled-executive-paper" aria-label="A4 print layout preview">
              <!-- Top Gold Ribbon -->
              <div class="paper-top-gold-ribbon"></div>

              <!-- Header -->
              <header class="letterhead-paper-header executive-paper-header">
                <div class="header-brand-cluster">
                  <span class="paper-logo" aria-hidden="true">
                    <img src="/images/brand-mark.svg" alt="" width="52" height="52">
                  </span>
                  <div class="paper-brand">
                    <strong class="firm-main-title">SHREE SHANTINATH ENTERPRISES</strong>
                    <b class="firm-sub-title">GOVT. CIVIL CONTRACTS, PWD WORKS &bull; CLEAN ENERGY INFRASTRUCTURE</b>
                    <small class="firm-cert-line">GOVT. REGD. MSME &bull; ISO &amp; SAFETY COMPLIANT (STP &amp; SOS PROTOCOLS)</small>
                  </div>
                </div>
                <div class="paper-tax-block">
                  <span>GSTIN: <b>08BOKPV8974D1Z5</b></span>
                  <span>STATE: <b>RAJASTHAN (08)</b></span>
                </div>
              </header>

              <!-- Gold Sub-rule -->
              <div class="paper-gold-accent-rule"></div>

              <!-- Metadata Bar (Date & Ref) -->
              <div class="paper-meta-bar">
                <div class="meta-ref-item" id="preview-ref-box">
                  <span class="meta-lbl">REF NO:</span>
                  <strong id="preview-reference"></strong>
                </div>
                <div class="meta-date-item" id="preview-date-box">
                  <span class="meta-lbl">DATE:</span>
                  <strong id="preview-date"></strong>
                </div>
              </div>

              <!-- Paper Body -->
              <div class="letterhead-paper-body executive-paper-body">
                <!-- Recipient Block -->
                <div class="paper-recipient-card" id="preview-recipient-wrap">
                  <span class="to-tag">To,</span>
                  <p class="paper-recipient" id="preview-recipient"></p>
                </div>

                <!-- Subject Box -->
                <div class="paper-subject-banner" id="preview-subject-wrap">
                  <span class="subject-tag">SUBJECT:</span>
                  <strong id="preview-subject"></strong>
                </div>

                <!-- Content Area -->
                <div class="paper-content-flow" id="preview-content"></div>

                <!-- Sign-off Block -->
                <div class="paper-signoff-block" id="preview-signoff-wrap">
                  <p class="signoff-intro">Yours faithfully,</p>
                  <p class="signoff-firm">For <strong>SHREE SHANTINATH ENTERPRISES</strong></p>
                  <div class="signoff-seal-container" style="height: 50px; min-height: 50px;"></div>
                  <p class="signoff-name"><strong>Harsh Vardhan</strong></p>
                  <p class="signoff-role">Proprietor / Authorized Signatory</p>
                </div>
              </div>

              <!-- Gold Footer Accent -->
              <div class="paper-gold-footer-rule"></div>

              <!-- Footer -->
              <footer class="letterhead-paper-footer executive-paper-footer">
                <div class="footer-row-1">
                  <strong>HEAD OFFICE:</strong> Jalore, Rajasthan - 343001 &bull; India &bull; Serving Clean Energy Projects Pan-India
                </div>
                <div class="footer-row-2">
                  <span>Phone: +91 96363 20419</span>
                  <span>Email: shreeshantinath.enterprises25@gmail.com</span>
                </div>
                <div class="footer-row-3">
                  <small>BUILT WITH INTEGRITY &bull; COMMITTED TO ZERO-HARM SAFETY &bull; GOVT. CIVIL CONTRACTS &amp; CLEAN ENERGY INFRASTRUCTURE</small>
                </div>
              </footer>
            </article>
          </div>

          <p class="preview-print-note">
            The letterhead follows clean A4 print geometry with 54pt lateral margins. Downloaded PDFs embed high-resolution vector assets.
          </p>
        </section>
      </div>
    </main>
    <script src="/js/letterhead-preview.js?v=6" defer></script>
    <script src="/js/main.js?v=5" defer></script>
  </body>
</html>
