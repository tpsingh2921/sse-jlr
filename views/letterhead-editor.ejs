<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f8f2">
    <meta name="robots" content="noindex, nofollow">
    <title><%= isNew ? 'New document' : 'Edit document' %> | Letterhead | Shree Shantinath Enterprises</title>
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=5">
  </head>
  <body class="letterhead-admin">
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Shree Shantinath Enterprises home">
          <span class="brand-mark" aria-hidden="true"><img src="/images/brand-mark.svg" alt="" width="48" height="48"></span>
          <span class="brand-name">SHREE SHANTINATH <b>ENTERPRISES</b></span>
        </a>
        <a class="admin-back-link" href="/letterhead">← All documents</a>
      </div>
    </header>
    <main class="admin-main admin-main-wide">
      <div class="admin-page-heading editor-heading">
        <div><p class="eyebrow"><span class="eyebrow-line"></span> COMPANY LETTERHEAD</p><h1><%= isNew ? 'Create a new' : 'Edit your' %><br><span>document.</span></h1><p class="admin-description">Your saved draft stays private. Download a print-ready PDF when it’s ready.</p></div>
        <a class="admin-back-link" href="/letterhead">← All documents</a>
      </div>
      <% if (saved) { %><p class="admin-alert admin-alert-success" role="status">Your changes have been saved.</p><% } %>
      <% if (error) { %><p class="admin-alert admin-alert-error" role="alert"><%= error %></p><% } %>
      <div class="editor-workspace">
      <form class="letterhead-editor-form" action="<%= isNew ? '/letterhead/documents' : '/letterhead/documents/' + document.id %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="editor-meta-grid">
          <label class="editor-title">Document title *<input name="title" maxlength="160" value="<%= document.title %>" placeholder="e.g. Project proposal — Solar Site A" required></label>
          <label>Date<input name="date" type="date" value="<%= document.document_date ? new Date(document.document_date).toISOString().slice(0, 10) : '' %>"></label>
          <label>To / recipient<textarea name="recipient" rows="3" maxlength="500" placeholder="Recipient name&#10;Company&#10;Address"><%= document.recipient %></textarea></label>
          <label>Reference<input name="reference" maxlength="100" value="<%= document.reference %>" placeholder="Optional reference number"></label>
          <label class="editor-subject">Subject<input name="subject" maxlength="300" value="<%= document.subject %>" placeholder="Optional subject"></label>
        </div>
        <label class="editor-body-label">Letter content *<textarea name="content" rows="16" maxlength="20000" placeholder="Write your letter here. Use a blank line between paragraphs." required><%= document.content %></textarea><span class="editor-hint">Plain text is formatted onto the company letterhead when you download the PDF. Long letters continue onto additional letterhead pages.</span></label>
        <div class="editor-footer">
          <a class="admin-cancel-link" href="/letterhead">Cancel</a>
          <div class="editor-actions">
            <a class="button button-outline" href="/letterhead/template" target="_blank" rel="noopener">Preview letterhead <span aria-hidden="true">↗</span></a>
            <% if (!isNew) { %><a class="button button-outline" href="/letterhead/documents/<%= document.id %>/download">Download PDF <span aria-hidden="true">↓</span></a><% } %>
            <button class="button button-dark" type="submit"><%= isNew ? 'Save document' : 'Save changes' %><span aria-hidden="true">↗</span></button>
          </div>
        </div>
      </form>
      <section class="letterhead-preview" aria-labelledby="letterhead-preview-title">
        <div class="letterhead-preview-heading">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> PRINT-READY VIEW</p><h2 id="letterhead-preview-title">Your letterhead.</h2></div>
          <span class="preview-page-size">A4 · PORTRAIT</span>
        </div>
        <p class="live-preview-status" id="live-preview-status" role="status" aria-live="polite">Update any field to refresh the preview.</p>
        <div class="letterhead-preview-frame">
          <article class="letterhead-paper" aria-label="A4 print layout preview">
            <header class="letterhead-paper-header">
              <span class="paper-logo" aria-hidden="true"><img src="/images/brand-mark.svg" alt="" width="48" height="48"></span>
              <div class="paper-brand"><strong>SHREE SHANTINATH</strong><b>ENTERPRISES</b><small>CIVIL WORKS&nbsp; · &nbsp;RENEWABLE ENERGY</small></div>
              <span class="paper-gst">GSTIN<br>08BOKPV8974D1Z5</span>
            </header>
            <div class="letterhead-paper-body">
              <p class="paper-date" id="preview-date"></p>
              <p class="paper-recipient" id="preview-recipient"></p>
              <p class="paper-reference" id="preview-reference"></p>
              <div class="paper-subject"><small>SUBJECT</small><strong id="preview-subject"></strong></div>
              <div class="paper-divider"></div>
              <p class="paper-content" id="preview-content"></p>
              <img class="paper-seal" src="/images/company-seal.png" alt="Shree Shantinath Enterprises proprietor seal">
            </div>
            <footer class="letterhead-paper-footer">
              <strong>LET’S BUILD A GREENER FUTURE.</strong>
              <span>+91 96363 20419&nbsp;&nbsp; · &nbsp;&nbsp;+91 78771 27423</span>
              <span>shreeshantinath.enterprises25@gmail.com</span>
              <small>JALORE, RAJASTHAN&nbsp; · &nbsp;INDIA</small>
            </footer>
          </article>
        </div>
        <p class="preview-print-note">The proprietor seal is included without the signature. The preview follows your edits; downloaded PDFs repeat the letterhead on additional pages when needed.</p>
      </section>
      </div>
    </main>
    <script src="/js/letterhead-preview.js?v=5" defer></script>
  </body>
</html>
