<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#071a14">
    <meta name="robots" content="noindex, nofollow">
    <title>Client Enquiries | Shree Shantinath Enterprises</title>
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon-enquiries.svg?v=7">
    <link rel="shortcut icon" href="/favicons/favicon-enquiries.svg?v=7">
    <link rel="apple-touch-icon" href="/favicons/favicon-enquiries.svg?v=7">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=31">
    <script>
      (function() {
        if (localStorage.getItem('sse_theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
  </head>
  <body class="letterhead-admin admin-hub-body">
    <!-- Top Global Admin Bar -->
    <header class="site-header admin-global-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Shree Shantinath Enterprises home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/images/brand-mark.svg" alt="" width="40" height="40">
          </span>
          <span class="brand-name">SHREE SHANTINATH <b>ENTERPRISES</b></span>
        </a>

        <!-- Admin Navigation Tabs -->
        <nav class="admin-top-tabs">
          <a href="/letterhead" class="admin-tab">
            <span class="tab-icon">📄</span> Letterheads
          </a>
          <a href="/admin/invoices" class="admin-tab">
            <span class="tab-icon">🧾</span> Tax Invoices
          </a>
          <a href="/admin/enquiries" class="admin-tab is-active">
            <span class="tab-icon">📬</span> Client Enquiries
            <% if (enquiries && enquiries.length > 0) { %>
              <span class="tab-count-badge"><%= enquiries.length %></span>
            <% } %>
          </a>
        </nav>

                <div class="admin-header-actions">
          <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark mode theme" title="Toggle gradient dark theme">
            <span class="sun-icon" style="display:none;">☀️</span>
            <span class="moon-icon">🌙</span>
            <span class="theme-toggle-label">Dark</span>
          </button>
          <% if (locals.adminUser) { %>
            <div class="admin-user-pill desktop-only-user-pill">
              <span class="user-status-dot"></span>
              <span><%= adminUser.name %></span>
            </div>
          <% } %>
          <a class="admin-back-link desktop-only-link" href="/" target="_blank">View Site ↗</a>
          <form action="/letterhead/logout" method="post" class="desktop-only-logout-form" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="admin-link-button" type="submit">Sign out</button>
          </form>

          <!-- Mobile Profile Trigger & Popover Menu -->
          <div class="admin-mobile-profile-wrap">
            <button type="button" class="mobile-profile-trigger" id="mobileProfileTrigger" aria-label="Toggle user menu" aria-expanded="false">
              <span class="profile-avatar-circle">
                <%= (locals.adminUser && adminUser.name) ? adminUser.name.charAt(0).toUpperCase() : 'H' %>
              </span>
              <span class="profile-online-badge"></span>
            </button>

            <div class="mobile-profile-dropdown" id="mobileProfileDropdown" role="menu">
              <div class="dropdown-user-header">
                <div class="dropdown-avatar">
                  <%= (locals.adminUser && adminUser.name) ? adminUser.name.charAt(0).toUpperCase() : 'H' %>
                </div>
                <div class="dropdown-user-meta">
                  <strong class="dropdown-user-name"><%= locals.adminUser ? adminUser.name : 'Harshvardhan Singh' %></strong>
                  <span class="dropdown-user-role">Online • Master Admin</span>
                </div>
              </div>
              <div class="dropdown-divider"></div>
              <a href="/" target="_blank" class="dropdown-menu-item" role="menuitem">
                <span>View Public Site</span> ↗
              </a>
              <div class="dropdown-divider"></div>
              <form action="/letterhead/logout" method="post" class="dropdown-logout-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-menu-item dropdown-logout-btn" role="menuitem">
                  <span>Sign out</span> 🚪
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-main admin-main-wide">
      <div class="admin-page-heading">
        <div>
          <p class="eyebrow"><span class="eyebrow-line"></span> CLIENT LEAD MANAGEMENT</p>
          <h1>Client Project <span>Enquiries.</span></h1>
          <p class="admin-description">
            Track, update status, and manage prospective developer and EPC contractor RFQs received through your public website contact form in real-time.
          </p>
        </div>
        <div class="admin-heading-actions">
          <button type="button" class="button button-outline export-action-btn" id="openExportModalBtn">
            <span>📥 Export Enquiries</span>
          </button>
          <a class="button button-outline" href="/#contact" target="_blank" rel="noopener">
            <span>Test Public Form</span> ↗
          </a>
        </div>
      </div>

      <% if (locals.deleted) { %>
        <p class="admin-alert admin-alert-success" role="status">Client enquiry deleted successfully.</p>
      <% } %>
      <% if (locals.statusUpdated) { %>
        <p class="admin-alert admin-alert-success" role="status">Client enquiry status updated successfully.</p>
      <% } %>

      <!-- Enquiry KPI Metrics Band -->
      <div class="invoice-metrics-band">
        <div class="inv-metric-card">
          <span class="inv-metric-label">TOTAL LEADS</span>
          <strong class="inv-metric-val text-green"><%= enquiries.length %></strong>
          <small>Direct Submissions</small>
        </div>
        <div class="inv-metric-card">
          <span class="inv-metric-label">NEW / UNTOUCHED</span>
          <strong class="inv-metric-val" style="color: #0284c7;">
            <%= enquiries.filter(e => !e.status || e.status === 'New').length %>
          </strong>
          <small>Requires Contact</small>
        </div>
        <div class="inv-metric-card">
          <span class="inv-metric-label">IN PIPELINE</span>
          <strong class="inv-metric-val" style="color: #d97706;">
            <%= enquiries.filter(e => ['In Discussion', 'Site Visit Scheduled', 'Quotation Sent'].includes(e.status)).length %>
          </strong>
          <small>Discussion &amp; Quotations</small>
        </div>
        <div class="inv-metric-card">
          <span class="inv-metric-label">CONVERTED / WON</span>
          <strong class="inv-metric-val" style="color: #10b981;">
            <%= enquiries.filter(e => e.status === 'Converted / Won').length %>
          </strong>
          <small>Active Project Contracts</small>
        </div>
      </div>

      <% if (enquiries.length) { %>
        <div class="enquiries-cards-container">
          <% enquiries.forEach((enq, index) => { %>
            <% const currentStatus = enq.status || 'New'; %>
            <article class="enquiry-card">
              <div class="enquiry-card-header">
                <div class="enquiry-client-info">
                  <div class="client-avatar">
                    <%= (enq.name || 'C').charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <h2 class="client-name-title"><%= enq.name || 'Anonymous Client' %></h2>
                    <% if (enq.company) { %>
                      <span class="client-company-tag">🏢 <%= enq.company %></span>
                    <% } %>
                  </div>
                </div>

                <!-- Status Selector & Action Controls -->
                <div class="enquiry-meta-header">
                  <!-- Live Status Selector Dropdown -->
                  <form action="/admin/enquiries/<%= enq.id %>/status" method="post" class="status-badge-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <span class="status-indicator-dot status-dot-<%= currentStatus.toLowerCase().replace(/[^a-z0-9]/g, '-') %>"></span>
                    <select name="status" class="status-dropdown-select status-select-<%= currentStatus.toLowerCase().replace(/[^a-z0-9]/g, '-') %>" onchange="this.form.submit()" aria-label="Change enquiry status" title="Click to update lead status">
                      <option value="New" <%= currentStatus === 'New' ? 'selected' : '' %>>🟢 New Lead</option>
                      <option value="In Discussion" <%= currentStatus === 'In Discussion' ? 'selected' : '' %>>💬 In Discussion</option>
                      <option value="Site Visit Scheduled" <%= currentStatus === 'Site Visit Scheduled' ? 'selected' : '' %>>📍 Site Visit Scheduled</option>
                      <option value="Quotation Sent" <%= currentStatus === 'Quotation Sent' ? 'selected' : '' %>>📋 Quotation Sent</option>
                      <option value="Converted / Won" <%= currentStatus === 'Converted / Won' ? 'selected' : '' %>>🏆 Converted / Won</option>
                      <option value="Closed / Archived" <%= currentStatus === 'Closed / Archived' ? 'selected' : '' %>>📁 Closed / Archived</option>
                    </select>
                  </form>

                  <span class="enquiry-time-badge">
                    <% if (enq.createdAt) { %>
                      <%= new Date(enq.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %> (IST)
                    <% } else { %>
                      Undated
                    <% } %>
                  </span>

                  <form action="/admin/enquiries/<%= enq.id %>/delete" method="post" data-confirm-delete="<%= enq.name %>" style="margin:0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-danger-button" title="Delete enquiry">Delete</button>
                  </form>
                </div>
              </div>

              <!-- Quick Contact Row -->
              <div class="enquiry-contact-bar">
                <% if (enq.email) { %>
                  <a href="mailto:<%= enq.email %>?subject=Re: Shree Shantinath Enterprises Project Enquiry" class="contact-pill-btn">
                    <span>✉</span> <%= enq.email %>
                  </a>
                <% } %>
                <% if (enq.phone) { %>
                  <a href="tel:<%= enq.phone %>" class="contact-pill-btn">
                    <span>📞</span> <%= enq.phone %>
                  </a>
                  <a href="https://wa.me/<%= enq.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="contact-pill-btn whatsapp-pill">
                    <span>💬</span> WhatsApp
                  </a>
                <% } %>
                <% if (enq.location) { %>
                  <span class="location-tag">
                    <span>📍</span> Location: <b><%= enq.location %></b>
                  </span>
                <% } %>
                <% if (enq.timeline) { %>
                  <span class="timeline-tag">
                    <span>⏱</span> Timeline: <b><%= enq.timeline %></b>
                  </span>
                <% } %>
              </div>

              <!-- Project Type & Requirements Box -->
              <div class="enquiry-scope-section">
                <% if (enq.projectType) { %>
                  <div class="project-type-pill">
                    <strong>Project Category:</strong> <%= enq.projectType %>
                  </div>
                <% } %>
                <div class="requirements-box">
                  <span class="req-label">CLIENT REQUIREMENTS &amp; SCOPE:</span>
                  <p class="requirements-text"><%= enq.requirements || 'No specific requirements detailed.' %></p>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <section class="admin-empty-card">
          <span class="empty-icon-spark">📬</span>
          <h2>No Client Enquiries Yet</h2>
          <p>When prospective developers or EPC contractors fill out the project form on the homepage, their details and technical scope will appear here immediately.</p>
          <a class="button button-dark" href="/#contact" target="_blank">
            <span>View Public Website Form</span> ↗
          </a>
        </section>
      <% } %>
    
      <!-- =========================================================================
           EXPORT CLIENT ENQUIRIES INTERACTIVE MODAL
           ========================================================================= -->
      <div class="export-modal-backdrop" id="exportModal" aria-hidden="true">
        <div class="export-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="exportModalTitle">
          <div class="export-modal-header">
            <div>
              <span class="export-kpi-pill">DATABASE EXPORT UTILITY</span>
              <h2 id="exportModalTitle">Export Client Enquiries</h2>
              <p class="export-modal-subtitle">Download submitted RFQ leads and client requirements to your local storage.</p>
            </div>
            <button type="button" class="export-modal-close" id="closeExportModalBtn" aria-label="Close export dialog">&times;</button>
          </div>

          <form id="exportForm" action="/admin/enquiries/export" method="get">
            <!-- 1. File Type Selection -->
            <div class="export-field-group">
              <label class="export-field-label">1. Select Export File Format:</label>
              <div class="export-format-grid">
                <label class="export-format-card">
                  <input type="radio" name="format" value="csv" checked>
                  <div class="format-card-content">
                    <span class="format-icon">📊</span>
                    <div>
                      <strong>CSV Spreadsheet (.csv)</strong>
                      <small>Formatted with all columns for Microsoft Excel, Google Sheets &amp; Numbers</small>
                    </div>
                  </div>
                </label>
                <label class="export-format-card">
                  <input type="radio" name="format" value="json">
                  <div class="format-card-content">
                    <span class="format-icon">📄</span>
                    <div>
                      <strong>JSON Data (.json)</strong>
                      <small>Complete raw structured database backup with all metadata</small>
                    </div>
                  </div>
                </label>
              </div>
            </div>

            <!-- 2. Time Period Selection -->
            <div class="export-field-group">
              <label class="export-field-label">2. Select Time Period of Data Required:</label>
              <div class="export-period-grid">
                <label class="export-period-pill">
                  <input type="radio" name="period" value="all" checked>
                  <span>All Time (Entire Database)</span>
                </label>
                <label class="export-period-pill">
                  <input type="radio" name="period" value="week">
                  <span>Last Week (7 Days)</span>
                </label>
                <label class="export-period-pill">
                  <input type="radio" name="period" value="month">
                  <span>Last Month (30 Days)</span>
                </label>
                <label class="export-period-pill">
                  <input type="radio" name="period" value="year">
                  <span>Last Year (365 Days)</span>
                </label>
                <label class="export-period-pill">
                  <input type="radio" name="period" value="custom" id="periodCustomRadio">
                  <span>Custom Date Range</span>
                </label>
              </div>
            </div>

            <!-- 3. Custom Date Range Inputs (Revealed when 'custom' is selected) -->
            <div class="custom-date-container" id="customDateContainer" style="display: none;">
              <div class="custom-date-grid">
                <div class="custom-date-field">
                  <label for="exportStartDate">Start Date (From):</label>
                  <input type="date" id="exportStartDate" name="startDate" class="form-control">
                </div>
                <div class="custom-date-field">
                  <label for="exportEndDate">End Date (To):</label>
                  <input type="date" id="exportEndDate" name="endDate" class="form-control">
                </div>
              </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="export-modal-actions">
              <button type="button" class="button button-outline" id="cancelExportBtn">Cancel</button>
              <button type="submit" class="button button-dark export-submit-btn">
                <span>Download to Local Storage</span>
                <span aria-hidden="true">&darr;</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const modal = document.getElementById('exportModal');
          const openBtn = document.getElementById('openExportModalBtn');
          const closeBtn = document.getElementById('closeExportModalBtn');
          const cancelBtn = document.getElementById('cancelExportBtn');
          const customContainer = document.getElementById('customDateContainer');
          const periodRadios = document.querySelectorAll('input[name="period"]');

          function openModal() {
            modal.classList.add('is-active');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }

          function closeModal() {
            modal.classList.remove('is-active');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }

          if (openBtn) openBtn.addEventListener('click', openModal);
          if (closeBtn) closeBtn.addEventListener('click', closeModal);
          if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

          modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.classList.contains('is-active')) {
              closeModal();
            }
          });

          periodRadios.forEach(function(radio) {
            radio.addEventListener('change', function() {
              if (this.value === 'custom') {
                customContainer.style.display = 'block';
              } else {
                customContainer.style.display = 'none';
              }
            });
          });
        });
      </script>

    </main>

    <script src="/js/letterhead.js" defer></script>
    <script src="/js/main.js?v=5" defer></script>
  </body>
</html>
