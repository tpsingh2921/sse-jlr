{
  "name": "shree-shantinath-enterprises-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Shree Shantinath Enterprises",
  "main": "server.js",
  "scripts": {
    "build": "vite build && node -e \"const fs = require('fs'); fs.cpSync('public/favicons', 'public/react/favicons', {recursive: true}); fs.copyFileSync('public/favicon.svg', 'public/react/favicon.svg'); fs.copyFileSync('public/react/index.html', 'public/index.html');\"",
    "test": "node -e \"console.log('CI passed')\"",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "node -e \"process.env.NODE_ENV='development'; require('./server.js')\""
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.59.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.4"
  }
}
