# Render Environment Variables Template
# Copy these to your Render Dashboard and fill in the values

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Connection (set on Render Dashboard)
# DATABASE_URL=postgresql://user:password@host:5432/web_dev

# Resend Email Configuration (set on Render Dashboard)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=enquiries@yourdomain.com
# CONTACT_EMAIL=info@yourdomain.com

# Letterhead Admin Configuration (set on Render Dashboard - KEEP PRIVATE!)
# LETTERHEAD_ADMIN_PASSWORD=strong_password_min_16_chars
# SESSION_SECRET=strong_secret_min_32_chars
